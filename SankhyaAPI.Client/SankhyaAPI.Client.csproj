<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<!-- SDK 8 não conhece net10.0: o gate roda net8.0 com SankhyaSoNet8=true. -->
		<TargetFrameworks Condition="'$(SankhyaSoNet8)' == 'true'">net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>SankhyaAPI</Title>
		<Authors>samueldias21</Authors>
		<Version>6.0.0</Version>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/SamuelGFDias/SankhyaAPI</RepositoryUrl>
		<PackageTags>Sankhya;ERP;Integracao</PackageTags>
		<NeutralLanguage>pt-BR</NeutralLanguage>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<Description>Cliente .NET para o ERP Sankhya (service.sbr): sessão gerenciada, mapa fluente de entidades, CRUD com update parcial, consultas paginadas, SQL seguro, relatórios, erros tipados com status HTTP sugerido e source generator compatível com AOT.</Description>
		<PackageProjectUrl>https://github.com/SamuelGFDias/SankhyaAPI</PackageProjectUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Membros públicos sem comentário XML não quebram o build; os principais estão documentados. -->
		<NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SankhyaAPI.Client.Tests" />
		<InternalsVisibleTo Include="SankhyaAPI.Client.Benchmarks" />
		<InternalsVisibleTo Include="SankhyaAPI.Client.Testing" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
	</ItemGroup>

	<!-- O generator e os analisadores vão dentro do pacote, em analyzers/dotnet/cs: quem instala ganha sem passo extra. -->
	<ItemGroup>
		<ProjectReference Include="..\SankhyaAPI.Client.Generators\SankhyaAPI.Client.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\SankhyaAPI.Client.Generators\bin\$(Configuration)\netstandard2.0\SankhyaAPI.Client.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
		<!-- Skill para agentes de IA, CHANGELOG e guia de migração: a skill lê esses arquivos da pasta da versão instalada. -->
		<None Include="..\skills\sankhyaapi-client\**\*" Pack="true" PackagePath="skills\sankhyaapi-client\" Visible="false" />
		<None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\docs\migracao-6.0.md" Pack="true" PackagePath="docs\" Visible="false" />
	</ItemGroup>

</Project>
